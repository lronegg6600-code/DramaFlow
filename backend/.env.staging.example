DRAMAFLOW_ENV=staging
DRAMAFLOW_GIN_MODE=release
DRAMAFLOW_POSTGRES_DSN=postgres://dramaflow:<password>@postgres.staging.dramaflow.example:5432/dramaflow?sslmode=require
DRAMAFLOW_REDIS_ADDR=redis.staging.dramaflow.example:6379
DRAMAFLOW_JWT_SECRET=<staging-jwt-secret>
DRAMAFLOW_JWT_ISSUER=staging.dramaflow.example
DRAMAFLOW_OTEL_ENDPOINT=http://otel-collector:4318/v1/traces
DRAMAFLOW_CONTENT_SERVICE_BASE_URL=http://content-service:8082
DRAMAFLOW_FEED_SERVICE_BASE_URL=http://feed-service:8083
DRAMAFLOW_PLAYBACK_SERVICE_BASE_URL=http://playback-service:8085
DRAMAFLOW_ENTITLEMENT_SERVICE_BASE_URL=http://entitlement-service:8086
DRAMAFLOW_BILLING_SERVICE_BASE_URL=http://billing-service:8087
DRAMAFLOW_ADMIN_SERVICE_BASE_URL=http://admin-service:8088
GOOGLE_PLAY_PACKAGE_NAME=com.dramaflow.app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=<secret-json>
BILLING_RTDN_ENABLED=true
BILLING_RTDN_PUSH_SECRET=<staging-rtdn-secret>
ADMIN_SESSION_SECRET=<staging-admin-session-secret>
ADMIN_BOOTSTRAP_EMAIL=admin@dramaflow.local
ADMIN_BOOTSTRAP_PASSWORD=<replace-in-secret-store>
ADMIN_ALLOWED_ORIGINS=https://admin.staging.dramaflow.example
