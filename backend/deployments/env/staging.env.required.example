DRAMAFLOW_TARGET_ENV=staging
DRAMAFLOW_CONTROL_PLANE=kubernetes
DRAMAFLOW_KUBE_NAMESPACE=dramaflow-staging
DRAMAFLOW_KUBECONFIG_SOURCE=platform-managed-secret
DRAMAFLOW_CLUSTER_RBAC_ROLE=edit
DRAMAFLOW_REGISTRY=registry.example.com/dramaflow
DRAMAFLOW_IMAGE_TAG=staging-<sha>
DRAMAFLOW_IMAGE_DIGEST=sha256:<digest>
DRAMAFLOW_ADMIN_BUILD_ARTIFACT=admin-web-<run-id>
DRAMAFLOW_RELEASE_VERSION=rc-<date>-<sha>
DRAMAFLOW_POSTGRES_DSN=<secret>
DRAMAFLOW_REDIS_ADDR=<secret>
DRAMAFLOW_HTTP_HANDLER_TIMEOUT=8s
DRAMAFLOW_HTTP_MAX_BODY_BYTES=1048576
DRAMAFLOW_HTTP_MAX_INFLIGHT=1000
DRAMAFLOW_JWT_SECRET=<secret>
ADMIN_SESSION_SECRET=<secret>
ADMIN_BOOTSTRAP_PASSWORD=<secret>
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=<secret>
BILLING_RTDN_PUSH_SECRET=<secret>
DRAMAFLOW_REGISTRY_USERNAME=<secret>
DRAMAFLOW_REGISTRY_PASSWORD=<secret>
DRAMAFLOW_CLOUD_SERVICE_ACCOUNT=<secret>
DRAMAFLOW_DEPLOY_TOKEN=<secret>
