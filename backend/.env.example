DRAMAFLOW_ENV=local
DRAMAFLOW_GIN_MODE=debug
DRAMAFLOW_POSTGRES_DSN=postgres://dramaflow:dramaflow@postgres:5432/dramaflow?sslmode=disable
DRAMAFLOW_REDIS_ADDR=redis:6379
DRAMAFLOW_JWT_SECRET=replace-with-local-secret
DRAMAFLOW_JWT_ISSUER=dramaflow.local
DRAMAFLOW_ACCESS_TOKEN_TTL=15m
DRAMAFLOW_REFRESH_TOKEN_TTL=720h
DRAMAFLOW_OTEL_ENDPOINT=http://otel-collector:4318/v1/traces
DRAMAFLOW_HTTP_READ_TIMEOUT=10s
DRAMAFLOW_HTTP_WRITE_TIMEOUT=10s
DRAMAFLOW_PLAYBACK_SIGNER_MODE=dev_passthrough
DRAMAFLOW_PLAYBACK_URL_TTL_SECONDS=300
DRAMAFLOW_PLAYBACK_HEARTBEAT_INTERVAL_SECONDS=15
DRAMAFLOW_PLAYBACK_REFRESH_BEFORE_SECONDS=45
DRAMAFLOW_PLAYBACK_CDN_BASE_URL=https://storage.googleapis.com/exoplayer-test-media-0
DRAMAFLOW_PLAYBACK_CLOUDFRONT_KEY_GROUP_ID=
DRAMAFLOW_PLAYBACK_CLOUDFRONT_PRIVATE_KEY_PEM=
DRAMAFLOW_PLAYBACK_CLOUDFRONT_KEY_PAIR_ID=
DRAMAFLOW_CONTENT_SERVICE_BASE_URL=http://content-service:8082
DRAMAFLOW_FEED_SERVICE_BASE_URL=http://feed-service:8083
DRAMAFLOW_PLAYBACK_SERVICE_BASE_URL=http://playback-service:8085
DRAMAFLOW_ENTITLEMENT_SERVICE_BASE_URL=http://entitlement-service:8086
DRAMAFLOW_BILLING_SERVICE_BASE_URL=http://billing-service:8087
DRAMAFLOW_ADMIN_SERVICE_BASE_URL=http://admin-service:8088
GOOGLE_PLAY_PACKAGE_NAME=com.dramaflow.app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PUBLISHER_SCOPE=https://www.googleapis.com/auth/androidpublisher
BILLING_SYNC_ACK_MODE=record_only
BILLING_RTDN_ENABLED=true
BILLING_RTDN_PUSH_SECRET=replace-with-local-rtdn-secret
ENTITLEMENT_DEFAULT_PREVIEW_SECONDS=15
ENTITLEMENT_GRACE_POLICY_ENABLED=true
ADMIN_SESSION_SECRET=replace-with-admin-session-secret
ADMIN_BOOTSTRAP_EMAIL=admin@dramaflow.local
ADMIN_BOOTSTRAP_PASSWORD=change-me-now
ADMIN_ALLOWED_ORIGINS=http://localhost:3000
ADMIN_ENABLE_DEV_OPERATIONS=false
NEXT_PUBLIC_ADMIN_API_BASE_URL=http://localhost:8088
